[Unit]
Description=Telescope Visual Tracking Dashboard
Wants=network-online.target celestron-bridge.service
After=network-online.target celestron-bridge.service
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/telescope-optical-tracking-control
ExecStart=%h/telescope-optical-tracking-control/tools/run_pi_vision_dashboard.sh
Restart=always
RestartSec=5
TimeoutStopSec=5
KillMode=control-group
SendSIGKILL=yes
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
